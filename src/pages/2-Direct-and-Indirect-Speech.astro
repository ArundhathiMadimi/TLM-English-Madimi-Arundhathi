  var mode="spot",sp,pk,bd;
  function resetPractice(){
    sp={i:0,score:0,ans:null,miss:[],q:TLM.deal("speech-spot-"+cls,SPOT[cls],8)};
    pk={i:0,score:0,ans:null,miss:[],q:TLM.deal("speech-pick-"+cls,PICK[cls],8).map(function(x){var c=x.o[x.a];return {d:x.d,w:x.w,c:c,o:shuffle(x.o)}})};
    bd={i:0,score:0,picked:[],checked:false,ok:false,miss:[],q:TLM.deal("speech-build-"+cls,BUILD[cls],6).map(function(x){return {d:x.d,ans:x.ans,bank:shuffle(x.ans.concat(x.x))}})};
    drawPractice();
  }
  function drawPractice(){
    document.querySelectorAll("#modeSeg button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.m===mode)});
    if(mode==="spot")drawSpot();else if(mode==="pick")drawPick();else drawBuild();
  }
  function ending(score,n){
    return score===n?"Perfect round. You can report like a pro."
      :score>=n*0.7?"Great work. Review the ones you missed and try again."
      :"Good start. Look at the three steps again, then play once more.";
  }
  function resultHTML(score,n,misses){return TLM.result(score,n,ending(score,n),misses)}

  function drawSpot(){
    var box=$("#pbody"),n=sp.q.length;
    if(sp.i>=n){box.innerHTML=resultHTML(sp.score,n,sp.miss.length);return}
    var q=sp.q[sp.i];
    box.innerHTML='<p class="count">Sentence '+(sp.i+1)+' of '+n+'</p>'+
      '<p class="qs">'+q[0]+'</p>'+
      '<div class="seg big" role="group" aria-label="Your answer"><button type="button" data-a="D">Direct</button><button type="button" data-a="I">Indirect</button></div>'+
      '<p class="fb" aria-live="polite"></p>'+
      '<button type="button" class="btn" data-act="next" hidden>'+(sp.i===n-1?"See my score":"Next sentence")+'</button>';
  }
  function drawPick(){
    var box=$("#pbody"),n=pk.q.length;
    if(pk.i>=n){box.innerHTML=resultHTML(pk.score,n,pk.miss.length);return}
    var q=pk.q[pk.i];
    box.innerHTML='<p class="count">Sentence '+(pk.i+1)+' of '+n+'</p>'+
      '<p class="qs">Report this: '+q.d+'</p>'+
      '<div class="opts">'+q.o.map(function(t,i){return '<button type="button" class="opt" data-o="'+i+'">'+esc(t)+'</button>'}).join("")+'</div>'+
      '<p class="fb" aria-live="polite"></p>'+
      '<button type="button" class="btn" data-act="next" hidden>'+(pk.i===n-1?"See my score":"Next sentence")+'</button>';
  }
  function drawBuild(){
    var box=$("#pbody"),n=bd.q.length;
    if(bd.i>=n){box.innerHTML=resultHTML(bd.score,n,bd.miss.length);return}
    var q=bd.q[bd.i];
    var tray=bd.picked.map(function(w,i){return '<button type="button" class="pick" data-rm="'+i+'"'+(bd.checked?' disabled':'')+'>'+esc(w)+'</button>'}).join("");
    var bank=q.bank.filter(function(w){return bd.picked.indexOf(w)<0}).map(function(w){return '<button type="button" class="pick" data-add="'+esc(w)+'">'+esc(w)+'</button>'}).join("");
    var fbText="",fbCls="fb";
    if(bd.checked){
      fbCls+=bd.ok?" good":" bad";
      fbText=bd.ok?"Correct. Well built.":"Not quite. The indirect speech is: “"+q.ans.join(" ")+".”";
    }
    box.innerHTML='<p class="count">Sentence '+(bd.i+1)+' of '+n+'</p>'+
      '<p class="qs">Make this indirect:<br>'+q.d+'</p>'+
      '<div class="tray'+(bd.checked?(bd.ok?" good":" bad"):"")+'" aria-label="Your sentence">'+tray+(bd.picked.length?'<span class="punct">.</span>':'<span class="count">Tap the pieces in order</span>')+'</div>'+
      '<div class="bank">'+bank+'</div>'+
      '<p class="'+fbCls+'" aria-live="polite">'+fbText+'</p>'+
      '<div class="row">'+
        (bd.checked
          ?'<button type="button" class="btn" data-act="next">'+(bd.i===bd.q.length-1?"See my score":"Next sentence")+'</button>'
          :'<button type="button" class="btn" data-act="check"'+(bd.picked.length===q.ans.length?'':' disabled')+'>Check</button><button type="button" class="btn alt" data-act="clear"'+(bd.picked.length?'':' disabled')+'>Clear</button>')+
      '</div>';
  }

  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){
      if(mode==="spot")sp=TLM.retry(sp.miss);
      else if(mode==="pick")pk=TLM.retry(pk.miss.map(function(x){return {d:x.d,w:x.w,c:x.c,o:shuffle(x.o)}}));
      else bd=TLM.retry(bd.miss.map(function(x){return {d:x.d,ans:x.ans,bank:shuffle(x.bank)}}));
      drawPractice();return;
    }
    if(mode==="spot"){
      if(b.dataset.act==="next"){sp.i++;sp.ans=null;drawSpot();return}
      if(b.dataset.a&&!sp.ans){
        var q=sp.q[sp.i],ok=b.dataset.a===q[1];
        sp.ans=b.dataset.a;if(ok)sp.score++;else sp.miss.push(q);
        var fb=$("#pbody .fb");
        fb.className="fb "+(ok?"good":"bad");
        fb.textContent=(ok?"Correct. ":"Not quite. ")+(q[1]==="D"?"The exact words are inside quotation marks, so this is direct speech.":"There are no quotation marks, and the parts are joined by that, if, to or a wh-word, so this is indirect speech.");
        document.querySelectorAll("#pbody .seg button").forEach(function(x){
          x.disabled=true;
          if(x.dataset.a===q[1])x.style.cssText="background:var(--good-bg);color:var(--good)";
          else if(x===b)x.style.cssText="background:var(--bad-bg);color:var(--bad)";
        });
        $("#pbody [data-act=next]").hidden=false;
      }
    }else if(mode==="pick"){
      if(b.dataset.act==="next"){pk.i++;pk.ans=null;drawPick();return}
      if(b.dataset.o!==undefined&&pk.ans===null){
        var p=pk.q[pk.i],idx=+b.dataset.o,ok2=p.o[idx]===p.c;
        pk.ans=idx;if(ok2)pk.score++;else pk.miss.push(p);
        var f2=$("#pbody .fb");
        f2.className="fb "+(ok2?"good":"bad");
        f2.textContent=(ok2?"Correct. ":"Not quite. ")+p.w;
        document.querySelectorAll("#pbody .opt").forEach(function(x,i){
          x.disabled=true;
          if(p.o[i]===p.c)x.classList.add("good");
          else if(i===idx)x.classList.add("bad");
        });
        $("#pbody [data-act=next]").hidden=false;
      }
    }else{
      if(b.dataset.act==="next"){bd.i++;bd.picked=[];bd.checked=false;drawBuild();return}
      if(b.dataset.act==="check"){
        var q2=bd.q[bd.i];
        bd.checked=true;bd.ok=bd.picked.join("|")===q2.ans.join("|");
        if(bd.ok)bd.score++;else bd.miss.push(q2);
        drawBuild();return;
      }
      if(b.dataset.act==="clear"){bd.picked=[];drawBuild();return}
      if(bd.checked)return;
      if(b.dataset.add!==undefined){bd.picked.push(b.dataset.add);drawBuild();return}
      if(b.dataset.rm!==undefined){bd.picked.splice(+b.dataset.rm,1);drawBuild();return}
    }
  });
  $("#modeSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b||b.dataset.m===mode)return;
    mode=b.dataset.m;drawPractice();
  });

  /* ---------- class bar ---------- */
  $("#classSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var c=+b.dataset.c;if(c===cls)return;
    cls=c;
    document.querySelectorAll("#classSeg button").forEach(function(x){x.setAttribute("aria-pressed",+x.dataset.c===cls)});
    drawRules();resetPractice();
  });

  drawRules();resetPractice();
})();
</script>
</Base>
