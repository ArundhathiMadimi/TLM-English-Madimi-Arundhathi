      if(s.checked){fbCls+=s.ok?" good":" bad";fbText=s.ok?"Correct. The order is "+order+".":"Not quite. The order is "+order+": the "+q.ans.join(" ")+" "+q.n+"."}
      html+='<p class="qs">Put the adjectives in the right order before “'+esc(q.n)+'”.</p>'+
        '<div class="tray'+(s.checked?(s.ok?" good":" bad"):"")+'" aria-label="Your phrase"><span class="w">the</span>'+(tray||'<span class="count">Tap the words in order</span>')+'<span class="w">'+esc(q.n)+'</span></div>'+
        '<div class="bank">'+bank+'</div><p class="'+fbCls+'" aria-live="polite">'+esc(fbText)+'</p><div class="row">'+
        (s.checked
          ?nextBtn
          :'<button type="button" class="btn" data-act="check"'+(s.picked.length===q.ans.length?'':' disabled')+'>Check</button><button type="button" class="btn alt" data-act="clear"'+(s.picked.length?'':' disabled')+'>Clear</button>')+
        '</div>';
    }
    box.innerHTML=html;
  }
  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){S[mode]=TLM.retry(mode==="order"?S[mode].miss.map(function(x){return ordQ(x)}):S[mode].miss);drawPractice();return}
    var s=S[mode];
    if(b.dataset.act==="next"){s.i++;s.ans=null;if(mode==="order"){s.picked=[];s.checked=false}drawPractice();return}
    if(mode==="order"){
      var q=s.q[s.i];
      if(b.dataset.act==="check"){s.checked=true;s.ok=s.picked.join("|")===q.ans.join("|");if(s.ok)s.score++;else s.miss.push(q);drawPractice();return}
      if(b.dataset.act==="clear"){s.picked=[];drawPractice();return}
      if(s.checked)return;
      if(b.dataset.add!==undefined){s.picked.push(b.dataset.add);drawPractice();return}
      if(b.dataset.rm!==undefined){s.picked.splice(+b.dataset.rm,1);drawPractice();return}
      return;
    }
    if(b.dataset.o===undefined||s.ans!==null)return;
    var qq=s.q[s.i],chosen=qq.o[+b.dataset.o],ok=chosen===qq.ans;
    s.ans=1;if(ok)s.score++;else s.miss.push(qq);
    var fb=$("#pbody .fb");
    fb.className="fb "+(ok?"good":"bad");
    if(mode==="spot"){
      fb.textContent=(ok?"Correct. ":"Not quite. ")+"“"+qq.ans+"” describes “"+qq.n+"”. It is "+(/^(demonstrative|interrogative|possessive)/.test(qq.k)?"a "+qq.k+" adjective":"an adjective of "+qq.k)+".";
    }else{
      $("#gap").textContent=qq.ans;
      fb.textContent=(ok?"Correct. ":"Not quite. The answer is “"+qq.ans+"”. ")+qq.e;
    }
    document.querySelectorAll("#pbody .opt").forEach(function(x){
      x.disabled=true;
      if(qq.o[+x.dataset.o]===qq.ans)x.classList.add("good");
      else if(x===b)x.classList.add("bad");
    });
    $("#pbody [data-act=next]").hidden=false;
  });
  $("#modeSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b||b.dataset.m===mode)return;
    mode=b.dataset.m;drawPractice();
  });

  /* ---------- class bar ---------- */
  $("#classSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var c=+b.dataset.c;if(c===cls)return;
    cls=c;
    document.querySelectorAll("#classSeg button").forEach(function(x){x.setAttribute("aria-pressed",+x.dataset.c===cls)});
    drawHelper();resetPractice();
  });

  drawHelper();resetPractice();
})();
</script>
</Base>
