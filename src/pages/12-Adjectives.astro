---
import Base from '../layouts/Base.astro';
import LessonNav from '../components/LessonNav.astro';
---
<Base title="Adjectives | TLM by Madimi Arundhathi" lesson>
<style is:inline slot="head">
:root{
  --A-bg:#FFF0C2; --A-c:#D99A00; --A-t:#6B4A00;
  --N-bg:#D5F3EE; --N-c:#13927F; --N-t:#0B5E55;
  --D-bg:#FFE3E6; --D-c:#D6334A; --D-t:#8F1226;
}

.hero h1{font-size:clamp(2.8rem,13.5vw,4.6rem);font-weight:800;letter-spacing:-.01em}
.hero .sub{font-size:1.15rem;margin:.6rem 0 1.2rem;max-width:30rem}
.stage{display:flex;flex-wrap:wrap;gap:.5rem;align-items:flex-start;min-height:5.6rem;margin:.2rem 0 .8rem}
.chip{display:inline-flex;flex-direction:column;gap:.15rem;padding:.5rem .85rem .4rem;border-radius:16px;border:2px solid;font:800 clamp(1.1rem,5.2vw,1.6rem)/1.15 var(--display)}
.chip i{font:700 .75rem/1 var(--body);font-style:normal;opacity:.85}
.chip.A{background:var(--A-bg);border-color:var(--A-c);color:var(--A-t)}
.chip.N{background:var(--N-bg);border-color:var(--N-c);color:var(--N-t);border-width:3px}
.chip.O{background:transparent;border-color:var(--line);color:var(--ink)}
.note{color:var(--muted);min-height:3.2rem;margin:0 0 .6rem}
.lab{font-weight:700;margin:.8rem 0 .4rem;font-size:.95rem}
.pills{display:flex;flex-wrap:wrap;gap:.5rem}
.pills button{appearance:none;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:700 1.05rem/1 var(--body);padding:.7rem 1rem;min-height:2.9rem;border-radius:30px;cursor:pointer}
.pills button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.key em{width:.9rem;height:.9rem;border-radius:5px;border:2px solid;display:inline-block}
.key .A{background:var(--A-bg);border-color:var(--A-c)}
.key .N{background:var(--N-bg);border-color:var(--N-c)}

.hl{border-radius:6px;padding:0 .2em;background:var(--A-bg);border-bottom:3px solid var(--A-c);color:var(--A-t);font-weight:800;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.uses{display:grid;gap:.8rem;margin-top:1rem}
.use{border-left:6px solid var(--accent);background:var(--surface);border-radius:0 16px 16px 0;padding:.8rem 1rem}
.use.A{border-left-color:var(--A-c)} .use.N{border-left-color:var(--N-c)} .use.D{border-left-color:var(--D-c)}
.use b{font-family:var(--display);font-size:1.15rem}
.use p{margin:.2rem 0}

.tlist{display:grid;gap:.8rem;margin-top:1rem}
.tcard{background:var(--surface);border:2px solid var(--line);border-radius:18px;padding:.95rem 1rem}
.tcard h3{font-size:1.2rem;font-weight:800;display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}
.new{font:700 .75rem var(--body);background:var(--accent);color:var(--accent-ink);border-radius:20px;padding:.2rem .6rem}
.formula{display:inline-block;margin:.5rem 0;padding:.3rem .7rem;border-radius:10px;border:2px solid var(--A-c);background:var(--A-bg);color:var(--A-t);font-weight:700}
.tcard p{margin:.25rem 0}
.ex{font:800 1.12rem/1.8 var(--display);margin-top:.4rem}

.grow{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;align-items:end;min-height:9.5rem;margin:.6rem 0 .4rem;text-align:center}
.shape{margin:0 auto;border-radius:50%;background:var(--sec,var(--accent));transition:width .35s,height .35s}
.grow b{display:block;font:800 clamp(1rem,4.6vw,1.3rem)/1.2 var(--display);margin-top:.4rem}
.grow small{display:block;color:var(--muted);font-size:.8rem;font-weight:700}
.degex{margin:.6rem 0 0;padding-left:1.2rem}
.degex li{margin:.2rem 0}

.olist{display:flex;flex-wrap:wrap;gap:.4rem;margin:.8rem 0;padding:0;list-style:none;counter-reset:o}
.olist li{counter-increment:o;border:2px solid var(--A-c);background:var(--A-bg);color:var(--A-t);border-radius:12px;padding:.35rem .7rem;font-weight:700}
.olist li::before{content:counter(o) ". "}
.irr{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;margin-top:.8rem;text-align:center}
.irr div{border:2px solid var(--line);border-radius:10px;padding:.35rem .2rem;font-weight:700}
.irr .h{background:var(--A-bg);border-color:var(--A-c);color:var(--A-t);font-family:var(--display);font-weight:800}
.irr.two{grid-template-columns:repeat(2,1fr)}

.qs{font:800 clamp(1.25rem,5.8vw,1.7rem)/1.45 var(--display);margin:.6rem 0 1rem}
.gap{display:inline-block;min-width:4.5rem;border-bottom:4px solid var(--ink);text-align:center;padding:0 .3em}
.fb{min-height:4.4rem;margin:.9rem 0 .6rem;font-weight:700}
.opts{display:grid;gap:.55rem}
.opts.row3{grid-template-columns:repeat(auto-fit,minmax(8rem,1fr))}
.opt{appearance:none;width:100%;text-align:left;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:800 1.15rem/1.3 var(--display);padding:.8rem 1rem;border-radius:14px;cursor:pointer;min-height:3rem}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt.good{background:var(--good-bg);border-color:var(--good);color:var(--good)}
.opt.bad{background:var(--bad-bg);border-color:var(--bad);color:var(--bad)}
.tray{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;min-height:3.6rem;padding:.6rem;border:2px dashed var(--line);border-radius:16px;margin:.6rem 0}
.tray.good{border-color:var(--good);background:var(--good-bg)} .tray.bad{border-color:var(--bad);background:var(--bad-bg)}
.tray .w{font:800 1.15rem var(--display)}
.pick{appearance:none;border:2px solid var(--accent);background:var(--surface);color:var(--ink);font:800 1.1rem var(--display);padding:.55rem .9rem;border-radius:12px;cursor:pointer;min-height:2.9rem}
.tray .pick{background:var(--accent);color:var(--accent-ink)}
.pick:disabled{opacity:.5;cursor:default}
.bank{display:flex;flex-wrap:wrap;gap:.5rem;margin:.8rem 0}
.result{padding:1rem 0}

@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.shape{transition:none}}
</style>

<header class="hero wrap">
  <h1>Adjectives</h1>
  <p class="sub">Adjectives are describing words. Tap the words and dress up the noun. Watch the sentence grow.</p>

  <div class="demo">
    <div class="stage" id="heroStage" aria-live="polite"></div>
    <p class="note" id="heroNote"></p>
    <p class="lab">Tap to add or remove a describing word</p>
    <div class="pills" id="heroPills" role="group" aria-label="Describing words"></div>
    <div class="row" style="margin-top:1rem">
      <button type="button" class="btn alt" id="nextEx">Next noun</button>
      <button type="button" class="btn alt" id="listen">Listen</button>
    </div>
    <div class="key" aria-label="Colour key">
      <span><em class="A"></em>adjective</span>
      <span><em class="N"></em>noun it describes</span>
    </div>
  </div>
  <p class="by">Teaching learning material for Classes 6 to 8, prepared by <strong>Madimi Arundhathi</strong></p>
</header>

<nav class="classbar" aria-label="Choose your class">
  <div class="wrap">
    <b>I am in class</b>
    <div class="seg" id="classSeg" role="group" aria-label="Class">
      <button type="button" data-c="6" aria-pressed="true">6</button>
      <button type="button" data-c="7" aria-pressed="false">7</button>
      <button type="button" data-c="8" aria-pressed="false">8</button>
    </div>
  </div>
</nav>

<main class="wrap">

  <section id="what">
    <h2>What is an adjective?</h2>
    <p class="lead">An adjective is a word that describes a noun. It tells us more about a person, animal, place or thing.</p>
    <div class="uses">
      <div class="use A"><b>Before the noun</b><p>Ravi has a <span class="hl">red</span> bicycle.</p></div>
      <div class="use N"><b>After is, am, are, was, were</b><p>The soup is <span class="hl">hot</span>.</p></div>
      <div class="use D"><b>Find it with a question</b><p>Ask “What kind?”, “How much?”, “How many?” or “Which one?” about the noun. The answer is the adjective.</p></div>
    </div>
  </section>

  <section id="kinds">
    <h2>Kinds of adjectives</h2>
    <p class="lead" id="kindLead"></p>
    <div class="tlist" id="klist"></div>
  </section>

  <section id="degrees">
    <h2>Degrees of comparison</h2>
    <p class="lead">An adjective has three degrees. We use them to compare one, two, or three and more things. Tap a word.</p>
    <div class="card">
      <div class="pills" id="degPills" role="group" aria-label="Choose an adjective"></div>
      <div class="grow" id="grow" aria-live="polite"></div>
      <p class="note" id="degRule"></p>
      <ol class="degex" id="degEx"></ol>
    </div>
    <div class="tlist" id="dlist"></div>
  </section>

  <section id="order" data-min="8" hidden>
    <h2>Order of adjectives</h2>
    <p class="lead">When we use many adjectives before a noun, they usually come in this order.</p>
    <div class="card">
      <ol class="olist">
        <li>opinion</li><li>size</li><li>age</li><li>shape</li><li>colour</li><li>origin</li><li>material</li><li>purpose</li>
      </ol>
      <p class="ex">a <span class="hl">lovely</span> <span class="hl">small</span> <span class="hl">old</span> <span class="hl">round</span> <span class="hl">red</span> <span class="hl">Indian</span> <span class="hl">wooden</span> box</p>
      <p>In real life we rarely use more than three. “A big old brown dog”, not “an old brown big dog”.</p>
      <p>The describing game at the top of the page always puts the words in this order. Try it.</p>
    </div>
  </section>

  <section id="forms" data-min="8" hidden>
    <h2>Adjective or adverb?</h2>
    <p class="lead">An adjective describes a noun. An adverb describes a verb: how something is done. Many adverbs end in -ly.</p>
    <div class="uses">
      <div class="use A"><b>good and well</b><p>Meena is a <span class="hl">good</span> singer. (adjective, describes singer)</p><p>Meena sings <b>well</b>. (adverb, describes sings)</p></div>
      <div class="use N"><b>quick and quickly</b><p>Arun is a <span class="hl">quick</span> runner.</p><p>Arun runs <b>quickly</b>.</p></div>
      <div class="use D"><b>After look, seem, feel, taste</b><p>Use an adjective: The milk tastes <span class="hl">sour</span>. The sea looks <span class="hl">calm</span>.</p></div>
    </div>
    <div class="card">
      <h3>Adjectives made from nouns</h3>
      <p class="lead">Add an ending to a noun to make an adjective.</p>
      <div class="irr two">
        <div class="h">noun</div><div class="h">adjective</div>
        <div>beauty</div><div>beautiful</div>
        <div>danger</div><div>dangerous</div>
        <div>courage</div><div>courageous</div>
        <div>rain</div><div>rainy</div>
        <div>child</div><div>childish</div>
        <div>gold</div><div>golden</div>
        <div>India</div><div>Indian</div>
        <div>comfort</div><div>comfortable</div>
      </div>
    </div>
  </section>

  <section id="practice">
    <h2>Practice time</h2>
    <p class="lead" id="pracLead">Play with your class. Take turns, or let teams answer together.</p>
    <div class="row" style="margin-top:.8rem">
      <div class="seg" id="modeSeg" role="group" aria-label="Practice mode">
        <button type="button" data-m="spot" aria-pressed="true">Spot it</button>
        <button type="button" data-m="fill" aria-pressed="false">Fill it</button>
        <button type="button" data-m="order" aria-pressed="false" hidden>Order it</button>
      </div>
    </div>
    <div class="card pbox" id="pbody"></div>
  </section>

  <section id="teacher">
    <h2>For the teacher</h2>
    <details>
      <summary>Objectives and lesson flow</summary>
      <p><b>Learners will be able to</b></p>
      <ul>
        <li>find adjectives in a sentence and name the noun each one describes;</li>
        <li>name the kinds of adjectives: quality, quantity and number (Class 6), demonstrative, interrogative and possessive (Class 7);</li>
        <li>form the three degrees of comparison, including more/most and irregular forms (Class 7);</li>
        <li>put adjectives in the right order, choose between an adjective and an adverb, use as … as and than, and make adjectives from nouns (Class 8).</li>
      </ul>
      <p><b>Time:</b> two periods of about 40 minutes. <b>Materials:</b> a projector or phone, a ball or any classroom object, word cards.</p>
      <ol>
        <li><b>Hook (5 min).</b> Hold up a ball. Students call out words that describe it. Write them around the word “ball” on the board.</li>
        <li><b>Teach (10 min).</b> Project the hero. Tap the words and read the sentence aloud. Ask: which word is the noun, and which words describe it?</li>
        <li><b>Kinds (7 min).</b> Pick your class on the bar. For each kind, students give one more example from the classroom.</li>
        <li><b>Degrees (8 min).</b> Call three students of different heights. The class makes sentences with tall, taller and tallest.</li>
        <li><b>Practice (8 min).</b> Teams play Spot it and Fill it. Class 8 also plays Order it.</li>
        <li><b>Exit ticket.</b> Each student describes their school bag in one sentence with two adjectives, and compares two things at home.</li>
      </ol>
    </details>
    <details>
      <summary>Common mistakes to watch for</summary>
      <ul>
        <li>Double comparatives: “more taller”, “most tallest”. Use one or the other.</li>
        <li>Wrong forms: “gooder”, “badder”, “beautifuller”. Good and bad are irregular; long words take more and most.</li>
        <li>Spelling: big → bigger (double g), happy → happier (y to i), large → larger (just add -r).</li>
        <li>Using the superlative for two things: “the tallest of the two” should be “the taller of the two”.</li>
        <li>“This books” and “these book”. This and that go with one; these and those with many.</li>
        <li>Mixing “its” (possessive) with “it’s” (it is).</li>
        <li>Using an adjective for an adverb: “She sings good” should be “She sings well”.</li>
        <li>Note that “this”, “which” and “my” are adjectives only when a noun follows. In “This is my bag”, “this” is a pronoun.</li>
      </ul>
    </details>
  </section>

  <LessonNav slug="12-Adjectives" />

  <footer>
    Teaching learning material (TLM) on Adjectives for Classes 6 to 8.<br>
    Prepared by <strong>Madimi Arundhathi</strong>.
  </footer>
</main>


<script is:inline>
(function(){
  "use strict";
  var $=function(s){return document.querySelector(s)};
  var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
  var cls=6;
  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}
  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;")}
  function say(t){try{speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(t);u.lang="en-IN";u.rate=.85;speechSynthesis.speak(u)}catch(err){}}

  /* ---------- hero: decorate a noun ---------- */
  var ORDER=["opinion","size","age","shape","colour","origin","material","purpose"];
  var HN=[
    {pre:"Meena has",n:"ball",a:[["lovely","opinion"],["small","size"],["new","age"],["round","shape"],["red","colour"],["rubber","material"]],on:["red"]},
    {pre:"Grandpa keeps",n:"box",a:[["beautiful","opinion"],["big","size"],["old","age"],["square","shape"],["brown","colour"],["wooden","material"]],on:["big"]},
    {pre:"Amma bought",n:"saree",a:[["pretty","opinion"],["long","size"],["new","age"],["green","colour"],["Dharmavaram","origin"],["silk","material"]],on:["silk"]},
    {pre:"Ravi has",n:"bat",a:[["nice","opinion"],["small","size"],["old","age"],["brown","colour"],["wooden","material"],["cricket","purpose"]],on:["cricket"]}
  ];
  var hi=0,hon=HN[0].on.slice(),pillsBox=$("#heroPills");
  function heroWords(){
    var h=HN[hi];
    return h.a.filter(function(x){return hon.indexOf(x[0])>=0}).sort(function(x,y){return ORDER.indexOf(x[1])-ORDER.indexOf(y[1])});
  }
  function article(w){return /^[aeiou]/i.test(w)?"an":"a"}
  function heroText(){var h=HN[hi],ws=heroWords().map(function(x){return x[0]});return h.pre+" "+article(ws.length?ws[0]:h.n)+" "+ws.concat([h.n]).join(" ")+"."}
  function drawHero(pop,rebuild){
    var h=HN[hi],ws=heroWords();
    var html='<span class="chip O">'+esc(h.pre)+'<i>&nbsp;</i></span><span class="chip O">'+article(ws.length?ws[0][0]:h.n)+'<i>&nbsp;</i></span>';
    html+=ws.map(function(x){return '<span class="chip A" data-w="'+esc(x[0])+'">'+esc(x[0])+'<i>'+esc(x[1])+'</i></span>'}).join("");
    html+='<span class="chip N">'+esc(h.n)+'.<i>noun</i></span>';
    $("#heroStage").innerHTML=html;
    $("#heroNote").textContent=ws.length===0?"No adjectives yet. Tap a word to describe the "+h.n+".":
      ws.length+(ws.length===1?" adjective tells":" adjectives tell")+" us more about the "+h.n+"."+(ws.length>1?" See how they always line up in the same order.":"");
    if(rebuild){pillsBox.innerHTML=h.a.map(function(x){return '<button type="button" data-w="'+esc(x[0])+'" aria-pressed="false">'+esc(x[0])+'</button>'}).join("")}
    pillsBox.querySelectorAll("button").forEach(function(b){b.setAttribute("aria-pressed",hon.indexOf(b.dataset.w)>=0)});
    if(pop&&!reduce){var el=$('#heroStage [data-w="'+pop+'"]');if(el&&el.animate)el.animate([{transform:"scale(.6)",opacity:.2},{transform:"none",opacity:1}],{duration:320,easing:"cubic-bezier(.3,.7,.2,1)"})}
  }
  pillsBox.addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var w=b.dataset.w,k=hon.indexOf(w);
    if(k>=0){hon.splice(k,1);drawHero(null,false)}else{hon.push(w);drawHero(w,false)}
  });
  $("#nextEx").addEventListener("click",function(){hi=(hi+1)%HN.length;hon=HN[hi].on.slice();drawHero(null,true)});
  $("#listen").addEventListener("click",function(){say(heroText())});
  drawHero(null,true);

  /* ---------- kinds ---------- */
  var KINDS=[
    {c:6,n:"Adjective of quality",f:"tall, red, kind, sweet, clever",d:"Tells what kind of person or thing. It answers “What kind?”",ex:"Mother made <span class=\"hl\">sweet</span> laddoos."},
    {c:6,n:"Adjective of quantity",f:"some, much, little, enough, all",d:"Tells how much of a thing. It goes with things we cannot count, like milk or rice.",ex:"There is <span class=\"hl\">some</span> milk in the jug."},
    {c:6,n:"Adjective of number",f:"one, three, first, few, many",d:"Tells how many, or in what order. It goes with things we can count.",ex:"Lata plucked <span class=\"hl\">five</span> roses."},
    {c:7,n:"Demonstrative adjective",f:"this, that, these, those",d:"Points out which one. This and that go with one thing; these and those with many.",ex:"<span class=\"hl\">These</span> mangoes came from Ratnagiri."},
    {c:7,n:"Interrogative adjective",f:"which, what, whose",d:"Asks a question about a noun. A noun comes right after it.",ex:"<span class=\"hl\">Whose</span> bag is on the desk?"},
    {c:7,n:"Possessive adjective",f:"my, your, his, her, its, our, their",d:"Tells whose thing it is. A noun comes right after it.",ex:"The cat licked <span class=\"hl\">its</span> paw."}
  ];
  /* ---------- degrees ---------- */
  var DEG=[
    {c:6,w:["tall","taller","tallest"],r:"A short word: add -er and -est.",ex:["Ravi is tall.","Anil is taller than Ravi.","Sunil is the tallest of the three."]},
    {c:6,w:["large","larger","largest"],r:"The word ends in e: just add -r and -st.",ex:["Our classroom is large.","The hall is larger than our classroom.","The playground is the largest of all."]},
    {c:6,w:["big","bigger","biggest"],r:"One vowel and one consonant at the end: double the last letter, then add -er and -est.",ex:["A dog is big.","A horse is bigger than a dog.","An elephant is the biggest of the three."]},
    {c:6,w:["happy","happier","happiest"],r:"A consonant and y at the end: change y to i, then add -er and -est.",ex:["Asha is happy.","Meena is happier than Asha.","Priya is the happiest girl in the class today."]},
    {c:7,w:["beautiful","more beautiful","most beautiful"],r:"A long word: put more and most before it.",ex:["Our school garden is beautiful.","The park is more beautiful than our garden.","Lalbagh is the most beautiful garden in Bengaluru."]},
    {c:7,w:["good","better","best"],r:"Irregular: the word changes completely. Learn it by heart.",ex:["Ravi’s drawing is good.","Asha’s drawing is better than Ravi’s.","Kiran’s drawing is the best of all."]},
    {c:7,w:["bad","worse","worst"],r:"Irregular: the word changes completely. Learn it by heart.",ex:["The traffic was bad on Monday.","It was worse on Tuesday.","Friday’s traffic was the worst of the week."]},
    {c:7,w:["many","more","most"],r:"Irregular. Much also becomes more and most.",ex:["Ravi has many marbles.","Anil has more marbles than Ravi.","Sunil has the most marbles of all."]},
    {c:7,w:["little","less","least"],r:"Irregular. Here the amount gets smaller, not bigger.",ex:["Gopi has little time.","Hari has less time than Gopi.","Anu has the least time of all."],shrink:1}
  ];
  var RULES=[
    {c:6,n:"Positive degree",f:"tall",d:"Describes one person or thing. No comparing.",ex:"Ravi is <span class=\"hl\">tall</span>."},
    {c:6,n:"Comparative degree",f:"taller + than",d:"Compares two persons or things.",ex:"Anil is <span class=\"hl\">taller</span> than Ravi."},
    {c:6,n:"Superlative degree",f:"the tallest",d:"Compares three or more. Use “the” before it.",ex:"Sunil is <span class=\"hl\">the tallest</span> boy in the class."},
    {c:7,n:"Long words",f:"more …, most …",d:"Words of two or more syllables, like careful, famous, beautiful, take more and most. Never say “more taller”.",ex:"Maths is <span class=\"hl\">more difficult</span> than English for me."},
    {c:8,n:"as … as",f:"as + adjective + as",d:"Shows two things are equal. “not as … as” shows they are not equal. Use the plain adjective.",ex:"Ravi is <span class=\"hl\">as tall</span> as his father."},
    {c:8,n:"than",f:"comparative + than",d:"Use than, not then, after a comparative.",ex:"This mango is <span class=\"hl\">sweeter</span> than that one."}
  ];
  var dsel=0;
  function degPool(){return DEG.filter(function(d){return d.c<=cls})}
  function drawDeg(pop){
    var P=degPool();if(dsel>=P.length)dsel=0;
