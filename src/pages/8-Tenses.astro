  function nameWhy(x){
    var t=byName(x.ans),verb=x.s.match(/\{\{(.+?)\}\}/g).map(function(m){return m.slice(2,-2)}).join(" … ");
    return "“"+verb+"” is "+t.f+", so the tense is the "+t.n.toLowerCase()+".";
  }

  var mode="fill",S={};
  function mine(a){return a.filter(function(x){return x.c<=cls})}
  function resetPractice(){
    var names=mine(TENSES).map(function(t){return t.n});
    S.fill={i:0,score:0,ans:null,miss:[],q:TLM.deal("tenses-fill-"+cls,mine(FILL),8).map(function(x){return {pre:x.pre,v:x.v,post:x.post,ans:x.o[0],w:x.w,o:shuffle(x.o)}})};
    S.name={i:0,score:0,ans:null,miss:[],q:TLM.deal("tenses-name-"+cls,mine(NAME),8).map(function(x){
      var other=shuffle(names.filter(function(n){return n!==x.ans})).slice(0,2);
      return {s:x.s,ans:x.ans,w:nameWhy(x),o:shuffle([x.ans].concat(other))};
    })};
    S.spot={i:0,score:0,ans:null,miss:[],q:TLM.deal("tenses-spot-"+cls,mine(SPOT),8).map(function(x){return {ans:x.o[0],w:x.w,o:shuffle(x.o)}})};
    drawPractice();
  }
  function drawPractice(){
    document.querySelectorAll("#modeSeg button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.m===mode)});
    var s=S[mode],box=$("#pbody"),n=s.q.length;
    if(s.i>=n){
      box.innerHTML=TLM.result(s.score,n,s.score===n?"Perfect round. You are a tense expert.":s.score>=n*0.7?"Great work. Check the ones you missed and try again.":"Good start. Look at the timeline again, then play once more.",s.miss.length);
      return;
    }
    var q=s.q[s.i],html='<p class="count">Question '+(s.i+1)+' of '+n+'</p>';
    function opts(row){return '<div class="opts'+(row?' row3':'')+'">'+q.o.map(function(x,i){return '<button type="button" class="opt" data-o="'+i+'"'+(x===q.ans?' data-right':'')+'>'+esc(x)+'</button>'}).join("")+'</div>'}
    if(mode==="fill"){
      html+='<p class="qs">'+esc(q.pre)+' <span class="gap" id="gap">&nbsp;</span> <span style="color:var(--muted)">('+esc(q.v)+')</span> '+esc(q.post)+'</p>'+opts(true);
    }else if(mode==="name"){
      html+='<p class="count">Which tense is the marked verb?</p><p class="qs">'+hlSent(q.s)+'</p>'+opts(false);
    }else{
      html+='<p class="qs">Which sentence is correct?</p>'+opts(false);
    }
    html+='<p class="fb" aria-live="polite"></p><button type="button" class="btn" data-act="next" hidden>'+(s.i===n-1?"See my score":"Next question")+'</button>';
    box.innerHTML=html;
  }
  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){S[mode]=TLM.retry(S[mode].miss);drawPractice();return}
    var s=S[mode];
    if(b.dataset.act==="next"){s.i++;s.ans=null;drawPractice();return}
    if(b.dataset.o===undefined||s.ans!==null)return;
    var q=s.q[s.i],ok=q.o[+b.dataset.o]===q.ans,fb=$("#pbody .fb");
    s.ans=1;if(ok)s.score++;else s.miss.push(q);
    fb.className="fb "+(ok?"good":"bad");
    fb.textContent=(ok?"Correct. ":"Not quite. ")+q.w;
    if(mode==="fill")$("#gap").textContent=q.ans;
    document.querySelectorAll("#pbody .opt").forEach(function(x){
      x.disabled=true;
      if(q.o[+x.dataset.o]===q.ans)x.classList.add("good");
      else if(x===b)x.classList.add("bad");
    });
    $("#pbody [data-act=next]").hidden=false;
  });
  $("#modeSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b||b.dataset.m===mode)return;
    mode=b.dataset.m;drawPractice();
  });

  /* ---------- class bar ---------- */
  $("#classSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var c=+b.dataset.c;if(c===cls)return;
    cls=c;
    document.querySelectorAll("#classSeg button").forEach(function(x){x.setAttribute("aria-pressed",+x.dataset.c===cls)});
    drawAspects();drawHero(false);drawTimeline();resetPractice();
  });

  drawAspects();drawHero(false);drawTimeline();resetPractice();
})();
</script>
