  /* spot: the first option is the correct sentence */
  var SPOT=[
    {o:["Raju plays cricket every day.","Raju playing cricket every day.","Raju play cricket every day."],w:"A habit with one person takes V1 + s: plays.",c:6},
    {o:["We went to the fair yesterday.","We go to the fair yesterday.","We will go to the fair yesterday."],w:"“Yesterday” shows the past, so use V2: went.",c:6},
    {o:["I will meet you tomorrow.","I met you tomorrow.","I will met you tomorrow."],w:"“Tomorrow” shows the future, so use will + V1: will meet.",c:6},
    {o:["The girls are dancing now.","The girls is dancing now.","The girls dancing now."],w:"“Now” needs the present continuous. “The girls” is plural: are dancing.",c:6},
    {o:["She is reading a book now.","She are reading a book now.","She is read a book now."],w:"Present continuous: is + V-ing for one person.",c:6},
    {o:["My brother goes to school by bus.","My brother go to school by bus.","My brother going to school by bus."],w:"A habit with one person takes V1 + es: goes.",c:6},
