---
import Base from '../layouts/Base.astro';
import LessonNav from '../components/LessonNav.astro';
---
<Base title="Tenses | TLM by Madimi Arundhathi" lesson>
<style is:inline slot="head">
:root{
  --S-bg:#FFE3E6; --S-c:#D6334A; --S-t:#8F1226;
  --V-bg:#FFF0C2; --V-c:#D99A00; --V-t:#6B4A00;
  --T-bg:#D5F3EE; --T-c:#13927F; --T-t:#0B5E55;
}

.hero h1{font-size:clamp(2.6rem,12vw,4.2rem);font-weight:800;letter-spacing:-.01em}
.hero .sub{font-size:1.15rem;margin:.6rem 0 1.2rem;max-width:30rem}
.stage{display:flex;flex-wrap:wrap;gap:.6rem;align-items:flex-start;min-height:5.6rem;margin:.2rem 0 .8rem}
.chip{display:inline-flex;flex-direction:column;gap:.15rem;padding:.5rem .85rem .4rem;border-radius:16px;border:2px solid;font:800 clamp(1.15rem,5.4vw,1.65rem)/1.15 var(--display)}
.chip i{font:700 .75rem/1 var(--body);font-style:normal;opacity:.85}
.chip.S{background:var(--S-bg);border-color:var(--S-c);color:var(--S-t)}
.chip.V{background:var(--V-bg);border-color:var(--V-c);color:var(--V-t);border-width:3px}
.chip.T{background:var(--T-bg);border-color:var(--T-c);color:var(--T-t)}
.chip.O{background:transparent;border-color:var(--line);color:var(--ink)}
.tense{font:800 1.15rem/1.2 var(--display);margin:0 0 .2rem}
.note{color:var(--muted);min-height:4.4rem;margin:0 0 .8rem}
.lab{font-weight:700;margin:.8rem 0 .4rem;font-size:.95rem}
.tl{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}
.tl::before{content:"";position:absolute;left:.5rem;right:.5rem;top:50%;height:5px;margin-top:-2px;background:var(--line);border-radius:5px}
.tl button{position:relative;appearance:none;border:3px solid var(--line);background:var(--surface);color:var(--ink);font:800 1.05rem/1.1 var(--display);min-height:3.2rem;padding:.5rem .4rem;border-radius:999px;cursor:pointer}
.tl button[aria-pressed="true"]{background:var(--T-bg);border-color:var(--T-c);color:var(--T-t)}
.pills{display:flex;flex-wrap:wrap;gap:.5rem}
.pills button{appearance:none;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:700 1rem/1 var(--body);padding:.7rem 1rem;min-height:2.9rem;border-radius:30px;cursor:pointer}
.pills button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.key em{width:.9rem;height:.9rem;border-radius:5px;border:2px solid;display:inline-block}
.key .S{background:var(--S-bg);border-color:var(--S-c)}
.key .V{background:var(--V-bg);border-color:var(--V-c)}
.key .T{background:var(--T-bg);border-color:var(--T-c)}

.hl{border-radius:6px;padding:0 .2em;-webkit-box-decoration-break:clone;box-decoration-break:clone;border-bottom:3px solid}
.hl.V{background:var(--V-bg);border-color:var(--V-c);color:var(--V-t);font-weight:800}
.new{font:700 .75rem var(--body);background:var(--accent);color:var(--accent-ink);border-radius:20px;padding:.2rem .6rem}

.arow{margin-top:1.2rem}
.arow h3{font-size:1.3rem;font-weight:800}
.cells{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.6rem;margin-top:.5rem}
.cell{background:var(--surface);border:2px solid var(--line);border-top:6px solid var(--tc);border-radius:16px;padding:.7rem .85rem}
.cell.t0{--tc:var(--c4)} .cell.t1{--tc:var(--c3)} .cell.t2{--tc:var(--c2)}
.cell small{display:block;color:var(--muted);font-weight:700;font-size:.8rem}
.cell h4{font:800 1.12rem/1.2 var(--display);margin:.1rem 0 .3rem;display:flex;flex-wrap:wrap;gap:.4rem;align-items:center}
.cell p{margin:.25rem 0}
.formula{display:inline-block;margin:.2rem 0;padding:.25rem .6rem;border-radius:10px;border:2px solid var(--V-c);background:var(--V-bg);color:var(--V-t);font-weight:700}
.cell .ex{font:800 1.08rem/1.7 var(--display)}

.uses{display:grid;gap:.8rem;margin-top:1rem}
.use{border-left:6px solid var(--T-c);background:var(--surface);border-radius:0 16px 16px 0;padding:.8rem 1rem}
.use b{font-family:var(--display);font-size:1.15rem}
.use p{margin:.3rem 0}
.words{display:flex;flex-wrap:wrap;gap:.4rem;margin:.4rem 0}
.words span{background:var(--T-bg);border:2px solid var(--T-c);color:var(--T-t);border-radius:20px;padding:.2rem .7rem;font-weight:700}

.qs{font:800 clamp(1.25rem,5.8vw,1.7rem)/1.45 var(--display);margin:.6rem 0 1rem}
.gap{display:inline-block;min-width:4.5rem;border-bottom:4px solid var(--ink);text-align:center;padding:0 .3em}
.fb{min-height:4.4rem;margin:.9rem 0 .6rem;font-weight:700}
.opts{display:grid;gap:.55rem}
.opts.row3{grid-template-columns:repeat(auto-fit,minmax(10rem,1fr))}
.opt{appearance:none;width:100%;text-align:left;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:700 1.05rem/1.35 var(--body);padding:.8rem 1rem;border-radius:14px;cursor:pointer;min-height:3rem}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt.good{background:var(--good-bg);border-color:var(--good);color:var(--good)}
.opt.bad{background:var(--bad-bg);border-color:var(--bad);color:var(--bad)}
.result{padding:1rem 0}

@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>

<header class="hero wrap">
  <h1>Tenses</h1>
  <p class="sub">A tense tells us when something happens. Move along the timeline and watch the verb change.</p>

  <div class="demo">
    <div class="stage" id="heroStage" aria-live="polite"></div>
    <p class="tense" id="hTense"></p>
    <p class="note" id="hNote"></p>

    <p class="lab">When does it happen?</p>
    <div class="tl" id="tl" role="group" aria-label="Time">
      <button type="button" data-t="0" aria-pressed="false">← Past</button>
      <button type="button" data-t="1" aria-pressed="true">Now</button>
      <button type="button" data-t="2" aria-pressed="false">Future →</button>
    </div>

    <p class="lab">What kind of action is it?</p>
    <div class="pills" id="aspects" role="group" aria-label="Kind of action"></div>

    <div class="row" style="margin-top:1rem">
      <button type="button" class="btn alt" id="nextSent">Next sentence</button>
      <button type="button" class="btn alt" id="listen">Listen</button>
    </div>
    <div class="key" aria-label="Colour key">
      <span><em class="S"></em>subject</span>
      <span><em class="V"></em>verb</span>
      <span><em class="T"></em>time words</span>
    </div>
  </div>
  <p class="by">Teaching learning material for Classes 6 to 8, prepared by <strong>Madimi Arundhathi</strong></p>
</header>

<nav class="classbar" aria-label="Choose your class">
  <div class="wrap">
    <b>I am in class</b>
    <div class="seg" id="classSeg" role="group" aria-label="Class">
      <button type="button" data-c="6" aria-pressed="true">6</button>
      <button type="button" data-c="7" aria-pressed="false">7</button>
      <button type="button" data-c="8" aria-pressed="false">8</button>
    </div>
  </div>
</nav>

<main class="wrap">

  <section id="timeline">
    <h2>The tense timeline</h2>
    <p class="lead" id="tlLead"></p>
    <div id="tgrid"></div>
  </section>

  <section id="clues">
    <h2>Time words</h2>
    <p class="lead">Time words are clues. Find the clue first, then choose the tense.</p>
    <div class="uses">
      <div class="use" data-min="6"><b>Simple present: habits and facts</b>
        <div class="words"><span>every day</span><span>always</span><span>usually</span><span>often</span><span>sometimes</span><span>never</span></div>
        <p>Raju <b>goes</b> to school every day.</p></div>
      <div class="use" data-min="6"><b>Simple past: finished actions</b>
        <div class="words"><span>yesterday</span><span>last week</span><span>two days ago</span><span>in 2020</span></div>
        <p>We <b>visited</b> the zoo yesterday.</p></div>
      <div class="use" data-min="6"><b>Simple future: later</b>
        <div class="words"><span>tomorrow</span><span>next week</span><span>soon</span><span>next year</span></div>
        <p>Grandma <b>will come</b> tomorrow.</p></div>
      <div class="use" data-min="6"><b>Present continuous: happening now</b>
        <div class="words"><span>now</span><span>right now</span><span>at the moment</span><span>Look!</span><span>Listen!</span></div>
        <p>Look! The children <b>are dancing</b>.</p></div>
      <div class="use" data-min="7"><b>Since or for? <span class="new" hidden>new this year</span></b>
        <p>Use <b>since</b> with a point in time and <b>for</b> with a length of time.</p>
        <div class="words"><span>since Monday</span><span>since 2019</span><span>since morning</span><span>for two days</span><span>for five years</span><span>for an hour</span></div>
        <p>I <b>have lived</b> here since 2019. I <b>have lived</b> here for seven years.</p></div>
      <div class="use" data-min="7"><b>Already, just, yet <span class="new" hidden>new this year</span></b>
        <p><b>Already</b> and <b>just</b> come between has / have and V3. <b>Yet</b> comes at the end of questions and “not” sentences.</p>
        <p>She <b>has already eaten</b>. I <b>have just come</b>. <b>Has</b> he <b>come</b> yet? He <b>has not come</b> yet.</p></div>
      <div class="use" data-min="7"><b>While and when <span class="new" hidden>new this year</span></b>
        <p>The longer action that was going on takes the past continuous. The short action takes the simple past.</p>
        <p>I <b>was reading</b> when the lights <b>went</b> out.</p></div>
      <div class="use" data-min="8"><b>Choose the tense from the context <span class="new" hidden>new this year</span></b>
        <p>1. When? Past, present or future. 2. Is the action finished, going on, finished before a time, or going on for some time up to a point?</p>
        <div class="words"><span>by tomorrow → will have + V3</span><span>since / for + still going on → has been + V-ing</span><span>for … when + past → had been + V-ing</span><span>by next year … for → will have been + V-ing</span></div>
        <p>By Friday, we <b>will have finished</b> the project. It <b>has been raining</b> since morning.</p></div>
    </div>
  </section>

  <section id="practice">
    <h2>Practice time</h2>
    <p class="lead">Play with your class. Take turns, or let teams answer together.</p>
    <div class="row" style="margin-top:.8rem">
      <div class="seg" id="modeSeg" role="group" aria-label="Practice mode">
        <button type="button" data-m="fill" aria-pressed="true">Fill it</button>
        <button type="button" data-m="name" aria-pressed="false">Name it</button>
        <button type="button" data-m="spot" aria-pressed="false">Spot it</button>
      </div>
    </div>
    <div class="card pbox" id="pbody"></div>
  </section>

  <section id="teacher">
    <h2>For the teacher</h2>
    <details>
      <summary>Objectives</summary>
      <p><b>Learners will be able to</b></p>
      <ul>
        <li>say whether an action is in the past, the present or the future;</li>
        <li>name and form the tenses for their class (Class 6: simple present, past and future, and present continuous; Class 7: past and future continuous, present and past perfect; Class 8: all twelve tenses);</li>
        <li>use time words as clues, including since and for, already, just and yet;</li>
        <li>choose the right tense from the context of a sentence.</li>
      </ul>
    </details>
    <details>
      <summary>How to use this in class</summary>
      <p><b>Time:</b> two periods of about 40 minutes. <b>Materials:</b> a projector or phone, and a long line drawn on the board marked Past, Now and Future.</p>
      <ol>
        <li><b>Hook (5 min).</b> Ask: “What did you do yesterday? What are you doing now? What will you do tomorrow?” Write the verbs on the board timeline.</li>
        <li><b>Teach (10 min).</b> Project the hero. Tap Past, Now and Future, then change the kind of action. Students say the sentence aloud before you tap Listen.</li>
        <li><b>Timeline (10 min).</b> Pick your class on the bar. Students copy the formulas into their notebooks as a table: time across, kind of action down.</li>
        <li><b>Time words (5 min).</b> Call out a time word. Students show one, two or three fingers for past, present or future.</li>
        <li><b>Practice (8 min).</b> Teams play Fill it, Name it and Spot it. Use “Try my mistakes again” for the questions they missed.</li>
        <li><b>Exit ticket.</b> Each student writes about their day in three sentences: one past, one present and one future.</li>
      </ol>
    </details>
    <details>
      <summary>Common mistakes to watch for</summary>
      <ul>
        <li>Forgetting -s in the simple present: “He play cricket.” should be “He plays cricket.”</li>
        <li>Using V2 after did: “Did she went?” should be “Did she go?”</li>
        <li>Dropping the helper: “They playing.” should be “They are playing.”</li>
        <li>Mixing since and for: “since two years” should be “for two years”.</li>
        <li>Using the present perfect with a finished time: “I have seen him yesterday.” should be “I saw him yesterday.”</li>
        <li>Using the present for an action that is still going on: “I am living here since 2019.” should be “I have been living here since 2019.” and “How long are you learning Hindi?” should be “How long have you been learning Hindi?”</li>
        <li>Using V2 after have, has or had: “He has went.” should be “He has gone.”</li>
      </ul>
    </details>
  </section>

  <LessonNav slug="8-Tenses" />

  <footer>
    Teaching learning material (TLM) on Tenses for Classes 6 to 8.<br>
    Prepared by <strong>Madimi Arundhathi</strong>.
  </footer>
</main>


<script is:inline>
(function(){
  "use strict";
  var $=function(s){return document.querySelector(s)};
  var reduce=window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches;
  var cls=6;
  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}
  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;")}
  function hlSent(s){return esc(s).replace(/\{\{(.+?)\}\}/g,'<span class="hl V">$1</span>')}

  /* ---------- the 12 tenses ----------
     t: 0 past, 1 present, 2 future. a: 0 simple, 1 continuous, 2 perfect, 3 perfect continuous.
     h(v,p) builds the hero sentence: v = [V1, V2, V3, V1 + s, V-ing], p = "1" (I), "3" (he, she, one person), "p" (plural).
     It returns [verb, time words]. */
  function be(p){return p==="1"?"am":p==="3"?"is":"are"}
  function was(p){return p==="p"?"were":"was"}
  function has(p){return p==="3"?"has":"have"}
  var TIMES=["Past","Present","Future"];
  var ASP=[{n:"Simple",c:6},{n:"Continuous",c:6},{n:"Perfect",c:7},{n:"Perfect continuous",c:8}];
  var TENSES=[
    {t:0,a:0,c:6,n:"Simple past",f:"V2",u:"A finished action in the past.",ex:"Ravi {{played}} cricket yesterday.",
      h:function(v){return [v[1],"yesterday"]}},
    {t:1,a:0,c:6,n:"Simple present",f:"V1 (V1 + s or es after he, she, it)",u:"Habits, daily routines and facts.",ex:"Meena {{goes}} to school every day.",
      h:function(v,p){return [p==="3"?v[3]:v[0],"every day"]}},
    {t:2,a:0,c:6,n:"Simple future",f:"will + V1",u:"An action that will happen later.",ex:"We {{will visit}} Lepakshi tomorrow.",
      h:function(v){return ["will "+v[0],"tomorrow"]}},
    {t:0,a:1,c:7,n:"Past continuous",f:"was / were + V-ing",u:"An action that was going on at a time in the past.",ex:"Amma {{was cooking}} when I came home.",
      h:function(v,p){return [was(p)+" "+v[4],"at this time yesterday"]}},
    {t:1,a:1,c:6,n:"Present continuous",f:"am / is / are + V-ing",u:"An action that is going on now.",ex:"The children {{are playing}} now.",
      h:function(v,p){return [be(p)+" "+v[4],"now"]}},
    {t:2,a:1,c:7,n:"Future continuous",f:"will be + V-ing",u:"An action that will be going on at a time in the future.",ex:"I {{will be travelling}} at this time tomorrow.",
      h:function(v){return ["will be "+v[4],"at this time tomorrow"]}},
    {t:0,a:2,c:7,n:"Past perfect",f:"had + V3",u:"The earlier of two past actions.",ex:"The bus {{had left}} before we reached the stop.",
      h:function(v){return ["had "+v[2],"before Amma came home"]}},
    {t:1,a:2,c:7,n:"Present perfect",f:"has / have + V3",u:"A finished action that matters now, or that has just happened.",ex:"Kiran {{has}} just {{finished}} her homework.",
      h:function(v,p){return [has(p)+" just "+v[2],""]}},
    {t:2,a:2,c:8,n:"Future perfect",f:"will have + V3",u:"An action that will be finished before a time in the future.",ex:"I {{will have finished}} the project by Monday.",
      h:function(v){return ["will have "+v[2],"by this evening"]}},
    {t:0,a:3,c:8,n:"Past perfect continuous",f:"had been + V-ing",u:"An action that had been going on for some time before another past action.",ex:"Raju {{had been waiting}} for an hour when the bus came.",
      h:function(v){return ["had been "+v[4],"for two hours when Amma came home"]}},
    {t:1,a:3,c:8,n:"Present perfect continuous",f:"has / have been + V-ing",u:"An action that began in the past and is still going on.",ex:"It {{has been raining}} since morning.",
      h:function(v,p){return [has(p)+" been "+v[4],"since morning"]}},
    {t:2,a:3,c:8,n:"Future perfect continuous",f:"will have been + V-ing",u:"An action that will have been going on for some time by a point in the future.",ex:"By June, we {{will have been living}} here for five years.",
      h:function(v){return ["will have been "+v[4],"for two hours by six o’clock"]}}
  ];
  function tenseAt(t,a){for(var i=0;i<TENSES.length;i++)if(TENSES[i].t===t&&TENSES[i].a===a)return TENSES[i]}
  function byName(n){for(var i=0;i<TENSES.length;i++)if(TENSES[i].n===n)return TENSES[i]}

  /* ---------- hero: move along the timeline ---------- */
  var HS=[
    {s:"Priya",p:"3",v:["write","wrote","written","writes","writing"],o:"a letter"},
    {s:"The boys",p:"p",v:["play","played","played","plays","playing"],o:"cricket"},
    {s:"I",p:"1",v:["cook","cooked","cooked","cooks","cooking"],o:"dinner"}
  ];
  var hi=0,ht=1,ha=0;
  function heroText(){var x=HS[hi],r=tenseAt(ht,ha).h(x.v,x.p);return x.s+" "+r[0]+" "+x.o+(r[1]?" "+r[1]:"")+"."}
  function drawAspects(){
    if(ASP[ha].c>cls)ha=0;
    $("#aspects").innerHTML=ASP.map(function(x,i){return x.c<=cls?'<button type="button" data-a="'+i+'" aria-pressed="'+(i===ha)+'">'+esc(x.n)+'</button>':""}).join("");
  }
  function drawHero(pop){
    var x=HS[hi],tn=tenseAt(ht,ha),r=tn.h(x.v,x.p);
    $("#heroStage").innerHTML=
      '<span class="chip S">'+esc(x.s)+'<i>subject</i></span>'+
      '<span class="chip V" id="vchip">'+esc(r[0])+'<i>'+esc(tn.f)+'</i></span>'+
      '<span class="chip O">'+esc(x.o)+(r[1]?'':'.')+'</span>'+
      (r[1]?'<span class="chip T">'+esc(r[1])+'.<i>time words</i></span>':'');
    $("#hTense").textContent=tn.n;
    $("#hNote").textContent=tn.u+(tn.c>cls?" You will learn this tense in Class "+tn.c+".":"");
    document.querySelectorAll("#tl button").forEach(function(b){b.setAttribute("aria-pressed",+b.dataset.t===ht)});
    document.querySelectorAll("#aspects button").forEach(function(b){b.setAttribute("aria-pressed",+b.dataset.a===ha)});
    if(pop&&!reduce){var c=$("#vchip");if(c.animate)c.animate([{transform:"translateX("+(ht===0?"-":"")+"1.2rem)",opacity:.3},{transform:"none",opacity:1}],{duration:340,easing:"cubic-bezier(.3,.7,.2,1)"})}
  }
  $("#tl").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;ht=+b.dataset.t;drawHero(true)});
  $("#aspects").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;ha=+b.dataset.a;drawHero(true)});
  $("#nextSent").addEventListener("click",function(){hi=(hi+1)%HS.length;drawHero(true)});
  $("#listen").addEventListener("click",function(){
    try{speechSynthesis.cancel();var u=new SpeechSynthesisUtterance(heroText());u.lang="en-IN";u.rate=.85;speechSynthesis.speak(u)}catch(err){}
  });

  /* ---------- timeline grid and time words ---------- */
  function drawTimeline(){
    $("#tlLead").textContent=cls===6
      ?"Class 6 learns the three simple tenses and the present continuous."
      :"Class "+cls+" revises the earlier tenses and adds new ones. The new ones are marked.";
    $("#tgrid").innerHTML=ASP.map(function(asp,a){
      if(asp.c>cls)return "";
      var cells=[0,1,2].map(function(t){
        var x=tenseAt(t,a);if(x.c>cls)return "";
        return '<article class="cell t'+t+'"><small>'+TIMES[t]+'</small><h4>'+esc(x.n)+(x.c===cls&&cls>6?'<span class="new">new this year</span>':'')+'</h4>'+
          '<span class="formula">'+esc(x.f)+'</span><p>'+esc(x.u)+'</p><p class="ex">'+hlSent(x.ex)+'</p></article>';
      }).join("");
      return '<div class="arow"><h3>'+esc(asp.n)+'</h3><div class="cells">'+cells+'</div></div>';
    }).join("");
    document.querySelectorAll("[data-min]").forEach(function(el){
      var m=+el.dataset.min;el.hidden=m>cls;
      var nw=el.querySelector(".new");if(nw)nw.hidden=m!==cls;
    });
  }

  /* ---------- practice data ---------- */
  /* fill: the first option is the answer */
  var FILL=[
    {pre:"My mother",v:"cook",post:"dinner every evening.",o:["cooks","cook","cooking"],w:"“Every evening” shows a habit. “My mother” is one person, so use V1 + s: cooks.",c:6},
    {pre:"The farmers",v:"work",post:"in the fields every day.",o:["work","works","working"],w:"“Every day” shows a habit. “The farmers” is plural, so use V1: work.",c:6},
    {pre:"Ravi",v:"go",post:"to Visakhapatnam yesterday.",o:["went","goes","will go"],w:"“Yesterday” shows the past, so use the simple past (V2): went.",c:6},
    {pre:"We",v:"watch",post:"a cricket match last Sunday.",o:["watched","watch","will watch"],w:"“Last Sunday” shows the past, so use the simple past (V2): watched.",c:6},
