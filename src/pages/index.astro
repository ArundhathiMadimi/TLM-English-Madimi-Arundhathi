---
import Base from '../layouts/Base.astro';
import { lessons } from '../lessons.js';
---
<Base title="English Grammar TLMs | Madimi Arundhathi">
<style is:inline slot="head">
.hero h1{font-size:clamp(2.4rem,11vw,3.8rem);font-weight:800}
.hero .sub{font-size:1.15rem;color:var(--muted)}
.topics{display:grid;gap:1rem;margin:1.6rem 0 0;padding:0;list-style:none}
.topics li:nth-child(6n+1){--t:var(--c1)} .topics li:nth-child(6n+2){--t:var(--c2)} .topics li:nth-child(6n+3){--t:var(--c3)}
.topics li:nth-child(6n+4){--t:var(--c4)} .topics li:nth-child(6n+5){--t:var(--c5)} .topics li:nth-child(6n+6){--t:var(--c6)}
.topics a{display:flex;align-items:center;gap:1rem;background:var(--surface);border:3px solid var(--t);border-radius:22px;padding:.85rem 1rem;color:var(--ink);text-decoration:none;box-shadow:0 6px 0 var(--t);transition:transform .15s,box-shadow .15s}
.topics a:hover{transform:translateY(-3px);box-shadow:0 9px 0 var(--t)}
.topics a:active{transform:translateY(4px);box-shadow:0 2px 0 var(--t)}
.ico{flex:none;width:3.4rem;height:3.4rem;display:grid;place-items:center;border-radius:18px;background:var(--t);font-size:1.8rem}
.topics b{display:block;font:800 1.3rem/1.15 var(--display)}
.topics small{display:block;color:var(--muted);font-size:.95rem}
@media (prefers-reduced-motion:reduce){.topics a{transition:none}}
</style>
<main class="wrap hero">
<h1>English Grammar TLMs</h1>
<p class="sub">Fun, interactive lessons for Classes 6 to 8. Pick a topic and start playing! Works without internet.</p>
<ul class="topics">
  {lessons.map((l) => (
    <li><a href={`${l.slug}.html`}><span class="ico" aria-hidden="true">{l.icon}</span><span><b>{l.title}</b><small>{l.blurb}</small></span></a></li>
  ))}
</ul>
<footer>Prepared by <strong>Madimi Arundhathi</strong></footer>
</main>
</Base>
