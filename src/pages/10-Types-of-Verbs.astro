    document.querySelectorAll("#modeSeg button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.m===mode)});
    var s=S[mode],box=$("#pbody"),n=s.q.length;
    if(s.i>=n){
      box.innerHTML=TLM.result(s.score,n,s.score===n?"Perfect round. You are a verb detective.":s.score>=n*0.7?"Great work. Check the ones you missed and try again.":"Good start. Read the kinds of verbs again, then play once more.",s.miss.length);
      return;
    }
    var q=s.q[s.i],L=optList(q),html='<p class="count">Question '+(s.i+1)+' of '+n+'</p>';
    var btns=L.map(function(x,i){return '<button type="button" class="opt" data-o="'+i+'"'+(i===L.indexOf(q.ans)?' data-right':'')+'>'+esc(x)+'</button>'}).join("");
    if(mode==="find"){
      html+='<p class="qs">'+esc(q.ask)+'</p><div class="opts words" role="group" aria-label="Words of the sentence">'+btns+'</div>';
    }else{
      html+='<p class="qs">'+hlSent(q.t)+'</p><p class="count" style="margin-bottom:.6rem">'+(mode==="mh"?"Is the highlighted word the main verb or a helping verb?":"What kind of verb is the highlighted word?")+'</p><div class="opts'+(mode==="mh"?" row3":"")+'">'+btns+'</div>';
    }
    html+='<p class="fb" aria-live="polite"></p><button type="button" class="btn" data-act="next" hidden>'+(s.i===n-1?"See my score":"Next question")+'</button>';
    box.innerHTML=html;
  }
  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){S[mode]=TLM.retry(S[mode].miss);drawPractice();return}
    var s=S[mode];
    if(b.dataset.act==="next"){s.i++;s.ans=null;drawPractice();return}
    if(b.dataset.o===undefined||s.ans!==null)return;
    var q=s.q[s.i],L=optList(q),ok=L[+b.dataset.o]===q.ans;
    s.ans=1;if(ok)s.score++;else s.miss.push(q);
    var fb=$("#pbody .fb");
    fb.className="fb "+(ok?"good":"bad");
    fb.textContent=(ok?"Correct. ":"Not quite. ")+(mode==="find"?"":q.ans+". ")+q.w;
    document.querySelectorAll("#pbody .opt").forEach(function(x){
      x.disabled=true;
      if(L[+x.dataset.o]===q.ans)x.classList.add("good");
      else if(x===b)x.classList.add("bad");
    });
    $("#pbody [data-act=next]").hidden=false;
  });
