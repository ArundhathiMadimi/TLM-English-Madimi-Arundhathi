  var mode="find",S={};
  function words(s){return s.split(" ").map(function(w){return w.replace(/~/g," ").replace(/[.,?!]$/,"")})}
  function resetPractice(){
    var F=FIND.filter(function(x){return x.c<=cls}),N=NAME.filter(function(x){return x.c<=cls}),M=MH.filter(function(x){return x.c<=cls});
    S.find={i:0,score:0,ans:null,miss:[],q:TLM.deal("verbtypes-find-"+cls,F,8).map(function(x){return {ask:ASK[x.k],ans:x.a,w:x.w,words:words(x.s),o:words(x.s)}})};
    S.name={i:0,score:0,ans:null,miss:[],q:TLM.deal("verbtypes-name-"+cls,N,8).map(function(x){return {t:x.t,ans:x.o[0],w:x.w,o:shuffle(x.o)}})};
    S.mh={i:0,score:0,ans:null,miss:[],q:TLM.deal("verbtypes-mh-"+cls,M,8).map(function(x){return {t:x.t,ans:x.m?"Main verb":"Helping verb",w:x.w,o:shuffle(["Main verb","Helping verb"])}})};
