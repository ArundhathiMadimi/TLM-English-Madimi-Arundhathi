    {pre:"A",post:"of people gathered to watch the parade.",ans:"crowd",o:["crowd","flock","bunch"],w:"We say a crowd of people.",c:6},
    {pre:"Our",post:"has forty students.",ans:"class",o:["class","herd","swarm"],w:"A group of students is a class.",c:6},
