  /* ODD: synonym pairs hidden among three pairs of opposites. */
  var SYN=[
    {c:6,a:"big",b:"large"},{c:6,a:"small",b:"little"},{c:6,a:"happy",b:"glad"},{c:6,a:"fast",b:"quick"},
    {c:6,a:"start",b:"begin"},{c:6,a:"shut",b:"close"},{c:6,a:"end",b:"finish"},{c:6,a:"sick",b:"ill"},
    {c:6,a:"rich",b:"wealthy"},{c:6,a:"under",b:"below"},{c:6,a:"gift",b:"present"},{c:6,a:"shout",b:"yell"},
    {c:6,a:"silent",b:"quiet"},{c:6,a:"stone",b:"rock"},{c:6,a:"jump",b:"leap"},{c:6,a:"kind",b:"nice"},
    {c:7,a:"unhappy",b:"sad"},{c:7,a:"incorrect",b:"wrong"},{c:7,a:"impolite",b:"rude"},{c:7,a:"unkind",b:"cruel"},
    {c:7,a:"useless",b:"worthless"},{c:7,a:"dishonest",b:"untruthful"},
    {c:8,a:"ancient",b:"old"},{c:8,a:"scarce",b:"rare"},{c:8,a:"victory",b:"win"},{c:8,a:"permanent",b:"lasting"},
    {c:8,a:"transparent",b:"clear"},{c:8,a:"brave",b:"courageous"},{c:8,a:"enormous",b:"huge"}
  ];
  function pr(a,b){return a+" – "+b}
  function antPairs(){return PICK.filter(function(p){return p.c<=cls&&!p.p&&!p.q})}

  /* ---------- class content ---------- */
  function pairsHTML(list){return list.map(function(p){return '<span class="pair"><span class="w A">'+esc(p.w)+'</span><i aria-hidden="true">↔</i><span class="w O">'+esc(p.a)+'</span></span>'}).join("")}
  $("#pairs6").innerHTML=pairsHTML(PICK.filter(function(p){return p.c===6}));
  $("#pairs8").innerHTML=pairsHTML(PICK.filter(function(p){return p.c===8&&!p.q}));
  var LEAD={6:"Class 6: simple pairs of opposites, and how we use them in a sentence.",7:"Class 7: opposites made with a prefix or a suffix, and choosing the opposite that fits the meaning. Class 6 words come back in the games.",8:"Class 8: gradable and complementary opposites, harder words and antonyms in a passage. Words from earlier classes come back in the games."};
  function drawLearn(){
    $("#learnLead").textContent=LEAD[cls];
    document.querySelectorAll("[data-show]").forEach(function(el){el.hidden=+el.dataset.show!==cls});
  }

  /* ---------- practice ---------- */
  function upto(list){return list.filter(function(x){return x.c<=cls})}
  var mode="pick",S={};
  function resetPractice(){
    S.pick={i:0,score:0,ans:null,miss:[],q:TLM.deal("antonyms-pick-"+cls,upto(PICK),8).map(function(p){
      return {p:p,ans:p.a,o:shuffle([p.a].concat(p.x))};
    })};
    S.fill={i:0,score:0,ans:null,miss:[],q:TLM.deal("antonyms-fill-"+cls,upto(FILL),8).map(function(p){
      return {p:p,ans:p.a,o:shuffle([p.a].concat(p.x))};
    })};
    var AP=antPairs();
    S.odd={i:0,score:0,ans:null,miss:[],q:TLM.deal("antonyms-odd-"+cls,upto(SYN),8).map(function(p){
      var ans=pr(p.a,p.b),ants=shuffle(AP).slice(0,3).map(function(x){return pr(x.w,x.a)});
      return {p:p,ans:ans,o:shuffle([ans].concat(ants))};
    })};
    drawPractice();
  }
  function pickQ(p){
    if(p.q)return p.q;
    if(p.p)return "What is the opposite of “"+p.w+"” in “"+p.p+"”?";
    return "What is the opposite of “"+p.w+"”?";
  }
  function pickWhy(p){
    if(p.n)return p.n;
    var w=p.w,a=p.a;
    if(a.length>w.length&&a.slice(-w.length)===w)return "Add “"+a.slice(0,a.length-w.length).replace(/-$/,"")+"-” to “"+w+"” to make “"+a+"”.";
    if(/ful$/.test(w)&&/less$/.test(a))return "Change “-ful” to “-less”: “"+w+"” becomes “"+a+"”.";
    return "The opposite of “"+w+"” is “"+a+"”.";
  }
  function gapHTML(s,fill){var bits=s.split("___");return esc(bits[0])+'<span class="blank">'+(fill?esc(fill):"&nbsp;")+'</span>'+esc(bits[1])}
  function drawPractice(){
    document.querySelectorAll("#modeSeg button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.m===mode)});
    var s=S[mode],box=$("#pbody"),n=s.q.length;
    if(s.i>=n){
      box.innerHTML=TLM.result(s.score,n,s.score===n?"Perfect round. You know your opposites.":s.score>=n*0.7?"Great work. Look at the pairs you missed and try again.":"Good start. Read the opposites for your class again, then play once more.",s.miss.length);
      return;
    }
    var q=s.q[s.i],p=q.p,html='<p class="count">Question '+(s.i+1)+' of '+n+'</p>',last=s.i===n-1;
    if(mode==="pick")html+='<p class="qs">'+esc(pickQ(p))+'</p>';
    else if(mode==="fill")html+='<p class="qs" id="gap">'+gapHTML(p.s)+'</p><p>Choose the opposite of “'+esc(p.w)+'” to fill the gap.</p>';
    else html+='<p class="qs">Three pairs are opposites. Which pair is <u>not</u>?</p>';
    html+='<div class="opts'+(mode==="odd"?"":" row3")+'">'+
      q.o.map(function(x,i){return '<button type="button" class="opt" data-o="'+i+'"'+(x===q.ans?' data-right':'')+'>'+esc(x)+'</button>'}).join("")+'</div>'+
      '<p class="fb" aria-live="polite"></p><button type="button" class="btn" data-act="next" hidden>'+(last?"See my score":"Next question")+'</button>';
    box.innerHTML=html;
  }
  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){S[mode]=TLM.retry(S[mode].miss);drawPractice();return}
    var s=S[mode];
    if(b.dataset.act==="next"){s.i++;s.ans=null;drawPractice();return}
    if(b.dataset.o===undefined||s.ans!==null)return;
    var q=s.q[s.i],p=q.p,chosen=q.o[+b.dataset.o],ok=chosen===q.ans;
    s.ans=1;if(ok)s.score++;else s.miss.push(q);
    var why;
    if(mode==="pick")why=pickWhy(p);
    else if(mode==="fill"){why="“"+p.a+"” is the opposite of “"+p.w+"”.";$("#gap").innerHTML=gapHTML(p.s,p.a)}
    else why="“"+p.a+"” and “"+p.b+"” mean almost the same, so they are synonyms, not opposites.";
    var fb=$("#pbody .fb");
    fb.className="fb "+(ok?"good":"bad");
    fb.textContent=(ok?"Correct. ":"Not quite. ")+why;
    document.querySelectorAll("#pbody .opt").forEach(function(x){
      x.disabled=true;
      if(q.o[+x.dataset.o]===q.ans)x.classList.add("good");
      else if(x===b)x.classList.add("bad");
    });
    $("#pbody [data-act=next]").hidden=false;
  });
  $("#modeSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b||b.dataset.m===mode)return;
    mode=b.dataset.m;drawPractice();
  });

  /* ---------- class bar ---------- */
  $("#classSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var c=+b.dataset.c;if(c===cls)return;
    cls=c;
    document.querySelectorAll("#classSeg button").forEach(function(x){x.setAttribute("aria-pressed",+x.dataset.c===cls)});
    drawLearn();resetPractice();
  });

  drawLearn();resetPractice();
})();
</script>
