    {c:6,s:"The rich man helped the ___ families in the village.",w:"rich",a:"poor",x:["wealthy","large"]},
    {c:6,s:"The giraffe has a long neck, but the rabbit has a ___ tail.",w:"long",a:"short",x:["tall","fluffy"]},

    {c:7,s:"This answer is not correct. It is ___.",w:"correct",a:"incorrect",x:["uncorrect","discorrect"]},
    {c:7,s:"It is not possible to finish the work in an hour. It is ___.",w:"possible",a:"impossible",x:["unpossible","inpossible"]},
    {c:7,s:"Riding without a licence is not legal. It is ___.",w:"legal",a:"illegal",x:["unlegal","dislegal"]},
    {c:7,s:"Kiran does not agree with me. He ___ with me.",w:"agrees",a:"disagrees",x:["unagrees","inagrees"]},
    {c:7,s:"Throwing litter is a careless act. We must be ___.",w:"careless",a:"careful",x:["careness","uncareless"]},
