    {c:6,s:"Raju’s bag is heavy, but my bag is ___.",w:"heavy",a:"light",x:["full","big"]},
    {c:6,s:"Cars stop at a red light and ___ at a green light.",w:"stop",a:"go",x:["wait","halt"]},
    {c:6,s:"Don’t push the door. ___ it.",w:"push",a:"Pull",x:["Press","Hit"]},
    {c:6,s:"The shopkeeper buys vegetables in the morning and ___ them in the evening.",w:"buys",a:"sells",x:["eats","cooks"]},
    {c:6,s:"Our team did not lose the match. We ___!",w:"lose",a:"won",x:["played","tried"]},
