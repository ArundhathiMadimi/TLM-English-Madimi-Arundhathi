    {pre:"You",post:"not wait. We have plenty of time.",ans:"need",o:["need","must","can"],w:"There is no need to wait. “Must not” would forbid it.",c:8},
    {pre:"The lights are off. They",post:"have gone to bed.",ans:"must",o:["must","should","need"],w:"It is a strong guess about the past: must have + V3.",c:8},
    {pre:"I",post:"have won the race, but I fell.",ans:"could",o:["could","must","should"],w:"It was a missed chance: could have + V3.",c:8},
    {pre:"You had",post:"hurry, or you will miss the train.",ans:"better",o:["better","best","good"],w:"“Had better” is strong advice with a warning.",c:8},
    {pre:"When I was a child, I",post:"play in the river every summer.",ans:"would",o:["would","must","shall"],w:"It was a repeated habit in the past: would.",c:8},
    {pre:"Students",post:"to respect their teachers.",ans:"ought",o:["ought","should","must"],w:"Only “ought” is followed by “to”.",c:8}
  ];
  var FIX=[
    {o:["She can swim.","She cans swim.","She can swims."],w:"A modal never changes form, and the next verb stays V1.",c:6},
    {o:["He can sing well.","He can to sing well.","He can sings well."],w:"No “to” and no -s after a modal.",c:6},
    {o:["May I come in?","May I to come in?","I may come in?"],w:"In a question the modal comes first, and there is no “to”.",c:6},
    {o:["You should study daily.","You should studying daily.","You should studied daily."],w:"After a modal use V1.",c:6},
    {o:["We must obey the rules.","We must obeys the rules.","We musts obey the rules."],w:"The modal and the verb after it do not take -s.",c:6},
    {o:["They cannot swim.","They cannot swims.","They not can swim."],w:"“Not” goes after the modal, and the verb stays V1.",c:6},
    {o:["Ravi can ride a bicycle.","Ravi can rides a bicycle.","Ravi can to ride a bicycle."],w:"After can use V1, with no -s and no “to”.",c:6},
    {o:["Can you swim?","Can you to swim?","You can swim?"],w:"In a question the modal comes before the subject, and there is no “to”.",c:6},
    {o:["It may rain today.","It mays rain today.","It may rains today."],w:"A modal never takes -s, and the verb after it stays V1.",c:6},
    {o:["You should eat fruit every day.","You should to eat fruit every day.","You should eats fruit every day."],w:"After should use V1, with no “to” and no -s.",c:6},
    {o:["We must wear our uniform.","We must to wear our uniform.","We must wearing our uniform."],w:"After must use V1, with no “to”.",c:6},
    {o:["I will call you tomorrow.","I will calls you tomorrow.","I will called you tomorrow."],w:"After will use V1.",c:6},
    {o:["She cannot come today.","She cannot comes today.","She not can come today."],w:"“Not” goes after the modal, and the verb stays V1.",c:6},
    {o:["Should I close the door?","Should I closed the door?","I should close the door?"],w:"In a question the modal comes first, and the verb stays V1.",c:6},
    {o:["Meena can draw well.","Meena cans draw well.","Meena can drew well."],w:"A modal never changes form, and the next verb stays V1.",c:6},
    {o:["You must not shout in class.","You must not to shout in class.","You do not must shout in class."],w:"Put not after the modal. Do not use “do”, and do not add “to”.",c:6},
    {o:["Could you help me?","Could you helped me?","You could help me?"],w:"A question puts the modal before the subject, and the verb stays V1.",c:7},
    {o:["Shall I open the door?","Shall I opening the door?","Shall I opened the door?"],w:"After shall use V1.",c:7},
    {o:["You mustn’t talk in class.","You don’t must talk in class.","You mustn’t to talk in class."],w:"Add not to the modal. Do not use “do”, and do not add “to”.",c:7},
    {o:["She might come tomorrow.","She might comes tomorrow.","She might came tomorrow."],w:"After might use V1.",c:7},
    {o:["I could swim when I was five.","I could swam when I was five.","I could to swim when I was five."],w:"After could use V1, with no “to”.",c:7},
    {o:["Would you pass the salt?","Would you passed the salt?","Would you to pass the salt?"],w:"After would use V1, with no “to”.",c:7},
    {o:["You should have told me.","You should have tell me.","You should has told me."],w:"Perfect modals use modal + have + V3.",c:8},
    {o:["He must have forgotten.","He must have forget.","He must has forgotten."],w:"Use must have + V3. “Have” never changes to “has” after a modal.",c:8},
    {o:["You needn’t come.","You needn’t to come.","You needn’t comes."],w:"After needn’t use V1, with no “to”.",c:8},
    {o:["I could have won.","I could have win.","I could has won."],w:"Use could have + V3.",c:8},
    {o:["Students ought to respect elders.","Students ought respect elders.","Students ought to respects elders."],w:"“Ought” is followed by “to” and then V1.",c:8},
    {o:["You had better hurry.","You had better to hurry.","You had better hurried."],w:"After had better use V1, with no “to”.",c:8}
  ];
  var JL={ability:"Ability",permission:"Permission",possibility:"Possibility",advice:"Advice",duty:"Duty or rule",request:"Polite request",offer:"Offer or suggestion",forbid:"Not allowed",noneed:"Not necessary",regret:"Regret about the past",guess:"Guess about the past",missed:"Missed chance",habit:"Past habit"};
  var NAME=[
    {t:"She {{can}} swim.",a:"ability",w:"It shows what she is able to do.",c:6},
    {t:"Birds {{can}} fly.",a:"ability",w:"It shows what birds are able to do.",c:6},
    {t:"{{May}} I drink some water?",a:"permission",w:"The speaker is asking for permission.",c:6},
    {t:"{{Can}} I go out to play?",a:"permission",w:"The speaker is asking for permission.",c:6},
    {t:"It {{may}} rain today.",a:"possibility",w:"It is possible, but not certain.",c:6},
    {t:"You {{should}} wake up early.",a:"advice",w:"The speaker says what is a good thing to do.",c:6},
