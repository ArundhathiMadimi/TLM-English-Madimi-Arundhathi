    {pre:"You",post:"not touch the wire. It is dangerous.",ans:"must",o:["must","might","would"],w:"It is forbidden, so use must not.",c:7},
    {pre:"",post:"you open the window, please?",ans:"Would",o:["Would","Must","Might"],w:"“Would you…?” makes a polite request.",c:7},
