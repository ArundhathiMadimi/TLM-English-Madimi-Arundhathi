  var mode="fill",S={};
  function resetPractice(){
    var F=FILL.filter(function(x){return x.c<=cls}),X=FIX.filter(function(x){return x.c<=cls});
    S.fill={i:0,score:0,ans:null,miss:[],q:TLM.deal("art-fill-"+cls,F,8).map(function(x){return {pre:x.pre,post:x.post,ans:x.ans,w:x.w,o:shuffle(x.o)}})};
    S.fix={i:0,score:0,ans:null,miss:[],q:TLM.deal("art-fix-"+cls,X,8).map(function(x){return {ans:x.o[0],w:x.w,o:shuffle(x.o)}})};
    drawPractice();
  }
  function drawPractice(){
    document.querySelectorAll("#modeSeg button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.m===mode)});
    var s=S[mode],box=$("#pbody"),n=s.q.length;
    if(s.i>=n){
      box.innerHTML=TLM.result(s.score,n,s.score===n?"Perfect round. You are an article star.":s.score>=n*0.7?"Great work. Check the ones you missed and try again.":"Good start. Read the cards for your class again, then play once more.",s.miss.length);
      return;
    }
    var q=s.q[s.i],html='<p class="count">Question '+(s.i+1)+' of '+n+'</p>';
    if(mode==="fill"){
      html+='<p class="qs">'+esc(q.pre)+' <span class="gap" id="gap">&nbsp;</span> '+esc(q.post)+'</p><div class="opts row3">';
    }else{
      html+='<p class="qs">Which sentence is correct?</p><div class="opts">';
    }
    html+=q.o.map(function(x,i){return '<button type="button" class="opt" data-o="'+i+'"'+(i===q.o.indexOf(q.ans)?' data-right':'')+'>'+esc(x)+'</button>'}).join("")+'</div>';
    html+='<p class="fb" aria-live="polite"></p><button type="button" class="btn" data-act="next" hidden>'+(s.i===n-1?"See my score":"Next question")+'</button>';
    box.innerHTML=html;
  }
  $("#pbody").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    if(b.dataset.act==="again"){resetPractice();return}
    if(b.dataset.act==="retry"){S[mode]=TLM.retry(S[mode].miss);drawPractice();return}
    var s=S[mode];
    if(b.dataset.act==="next"){s.i++;s.ans=null;drawPractice();return}
    if(b.dataset.o===undefined||s.ans!==null)return;
    var q=s.q[s.i],ok=q.o[+b.dataset.o]===q.ans;
    s.ans=1;if(ok)s.score++;else s.miss.push(q);
    var fb=$("#pbody .fb");
    fb.className="fb "+(ok?"good":"bad");
    fb.textContent=(ok?"Correct. ":"Not quite. ")+q.w;
    if(mode==="fill")$("#gap").textContent=q.ans===NONE?"—":q.ans;
    document.querySelectorAll("#pbody .opt").forEach(function(x){
      x.disabled=true;
      if(q.o[+x.dataset.o]===q.ans)x.classList.add("good");
      else if(x===b)x.classList.add("bad");
    });
    $("#pbody [data-act=next]").hidden=false;
  });
  $("#modeSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b||b.dataset.m===mode)return;
    mode=b.dataset.m;drawPractice();
  });

  /* ---------- class bar ---------- */
  $("#classSeg").addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var c=+b.dataset.c;if(c===cls)return;
    cls=c;
    document.querySelectorAll("#classSeg button").forEach(function(x){x.setAttribute("aria-pressed",+x.dataset.c===cls)});
    drawKinds();resetPractice();
  });

  drawKinds();resetPractice();
})();
</script>
