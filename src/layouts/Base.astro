---
// Shared page shell. Pass `lesson` on lesson pages to get the "All topics" button.
const { title, lesson = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Baloo+2:wght@600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="theme.css">
{lesson && <script is:inline src="practice.js"></script>}
<slot name="head" />
</head>
<body>
{lesson && <nav class="topnav wrap" aria-label="Site"><a class="btn alt" href="index.html"><span aria-hidden="true">🏠</span> All topics</a><button type="button" class="btn alt" id="soundBtn" hidden>Sound</button></nav>}
<slot />
{lesson && <script is:inline src="feedback.js"></script>}
</body>
</html>
